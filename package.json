{
  "name": "pubquiz",
  "productName": "Pubquiz",
  "version": "0.1.0",
  "private": true,
  "description": "Pubquizen in elkaar klikken en live draaien: video-loops op externe schermen, geluidsfragmenten op meerdere audio-uitgangen.",
  "main": "./out/main/index.js",
  "author": "Remco Hendriksen",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "pnpm typecheck && electron-vite build",
    "build:mac": "pnpm build && electron-builder --mac",
    "build:unpack": "pnpm build && electron-builder --mac --dir",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/make-demo.mjs && electron-vite build && playwright test",
    "demo": "node scripts/make-demo.mjs",
    "format": "prettier --write .",
    "postinstall": "install-electron && electron-builder install-app-deps"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/devtools-api": "^8.2.1",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "pinia": "4.1.0",
    "prettier": "^3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  }
}
